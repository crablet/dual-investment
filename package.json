{
  "name": "dual-investment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tauri desktop app that runs Binance dual-investment-style live option and spot strategies.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint src vite.config.ts eslint.config.mjs",
    "lint:fix": "eslint src vite.config.ts eslint.config.mjs --fix",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@lucide/vue": "^1.20.0",
    "@tauri-apps/api": "^2.11.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
