{
  "name": "dual-investment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tauri desktop app that simulates Binance Dual Investment using options and spot execution.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vue-tsc --noEmit && vite build",
